{
  "manifest_version": 3,
  "name": "Cover Letter Agent JD Import",
  "version": "0.1.0",
  "description": "Extract job details from supported pages and import to local Cover Letter Agent.",
  "permissions": [
    "sidePanel",
    "tabs",
    "storage"
  ],
  "host_permissions": [
    "https://*.linkedin.com/*",
    "https://*.joinhandshake.com/*",
    "http://127.0.0.1:3031/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Open JD Import Panel"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.linkedin.com/*",
        "https://*.joinhandshake.com/*"
      ],
      "js": ["content-script.js"],
      "run_at": "document_idle"
    }
  ]
}
